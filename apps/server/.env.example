PORT=8787
WEB_ORIGIN=http://127.0.0.1:5173

# 相对仓库根目录
SQLITE_PATH=data/ai-is-on.sqlite

CLAUDE_CODE_CLI=/Users/xinming/MyProject/claude-code-research/package/cli.js
CLAUDE_TOOLS=Bash,WebSearch,WebFetch
CLAUDE_ALLOWED_TOOLS=Bash(lark-cli:*)
# OAuth 路径下保持 false（不加 --bare）。改 API key 时设为 true。
CLAUDE_USE_BARE=false

SPEECH_ASR_PROVIDER=feishu
SPEECH_MAX_SECONDS=60
FFMPEG_BIN=ffmpeg
LARK_CLI_BIN=lark-cli

# MVP1 后台 collector + triage
COLLECTOR_ENABLED=true
CALENDAR_COLLECTOR_INTERVAL_MS=300000

# IM collector：逐 chat 增量拉取（§13.6 MVP2 路线）
# 群消息通过 chat-list 发现 + chat-messages-list 逐个拉；p2p 走 messages-search --chat-type p2p。
IM_COLLECTOR_INTERVAL_MS=180000
# 首次扫描往回看几小时（之后用 last_scan_at 增量）
IM_FIRST_SCAN_HOURS=2
# 单 chat 在一轮内新消息超过此阈值 → 聚合成 1 条信号（"群 X 新增 N 条"）
IM_AGGREGATE_THRESHOLD=3
# 每轮 IM 扫描产出的信号硬上限，超过时按优先级裁掉低价值的
IM_MAX_SIGNALS_PER_SCAN=30
# 单 chat chat-messages-list 的 page size
IM_PER_CHAT_PAGE_SIZE=50
# chat-list 最多翻多少页（page-size 固定 100）
IM_CHAT_LIST_MAX_PAGES=5
# 并发拉取的 chat 数（控制 lark-cli 子进程数量）
IM_CHAT_FETCH_CONCURRENCY=4
# MVP24 外部联系人单聊：messages-search 拿不到跨租户单聊，改用 chat-list --types=p2p 枚举 + chat-messages-list 双向拉取
IM_ENABLE_EXTERNAL_P2P=true
# 单轮最多处理多少个外部单聊（ByActiveTimeDesc 取前 N）
IM_EXTERNAL_P2P_MAX_CHATS=20

# Triage 队列
TRIAGE_QUEUE_CONCURRENCY=1
TRIAGE_TIMEOUT_MS=90000
TRIAGE_BATCH_SIZE=6
